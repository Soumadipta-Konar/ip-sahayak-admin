# ==============================================================================
# IP-SAKTI Sahayak (Admin & Ingestion Platform) - Environment Configuration Example
# Copy this file to .env and fill in your actual production/secret values.
# ==============================================================================

# --- Project & Environment ---
PROJECT_NAME="IP-SAKTI Sahayak Admin"
VERSION="1.0.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# --- LLM & AI Services (Optional for Ingestion, required if enriching/summarizing) ---
OPENAI_API_KEY="sk-proj-example-openai-key-xxxxxxxxxxxxxxxxxxxxxxxx"
BHASHINI_API_KEY="example-bhashini-api-key-xxxxxxxxxxxxxxxxxxxxxxxx"
BHASHINI_USER_ID="example_bhashini_user_id"
BHASHINI_PIPELINE_ID="example_bhashini_pipeline_id"

# --- Embeddings & ETL Pipeline Settings ---
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
EMBEDDING_METRIC="Cosine"
QDRANT_COLLECTION_NAME="legal_chunks"
BATCH_SIZE=64

# --- Raw Data Storage / Ingestion Sources ---
RAW_DATA_DRIVE_URL="https://drive.google.com/drive/folders/1example_FolderID_xxxxxxxxxx"
CORPUS_LOCAL_DIR="corpus_extracted"
CORPUS_INDEX_FILE="corpus_index.csv"

# --- Vector Database (Qdrant) ---
# For local Docker: http://localhost:6333
# For Qdrant Cloud: https://xxxx-xxxx.eu-central.aws.cloud.qdrant.io:6333
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# --- Knowledge Graph Database (Neo4j) ---
# Standard local bolt port is 7687, HTTP browser on 7474
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASS="ipsakti_secret_password"

# --- Relational Database (PostgreSQL) ---
# Used for ingestion tracking, audit logs, and user management
POSTGRES_USER="ipsakti_user"
POSTGRES_PASSWORD="ipsakti_secret_password"
POSTGRES_DB="ipsakti_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://ipsakti_user:ipsakti_secret_password@localhost:5432/ipsakti_db"

# --- Celery & Redis Task Queue ---
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# --- Admin Server Settings ---
HOST="0.0.0.0"
PORT=8000
DEBUG=True
